generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Members who signed in to the Knights Rolden website with their Chess.com username.
model SiteMember {
  id           String   @id @default(cuid())
  username     String   @unique // lowercase chess.com username
  displayName  String?
  avatarUrl    String?
  country      String?
  isClubMember Boolean  @default(false)
  verified     Boolean  @default(false)
  signinCount  Int      @default(1)
  createdAt    DateTime @default(now())
  lastSeenAt   DateTime @updatedAt

  @@index([username])
}
